:root {
  --green-dark: #1f5d3a;
  --green: #2e8b57;
  --green-light: #e8f4ec;
  --text: #2b2b2b;
  --muted: #666;
  --white: #fff;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: "Segoe UI", Roboto, Arial, sans-serif;
  color: var(--text);
  line-height: 1.7;
  background: var(--white);
}

.container {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 20px;
}

/* Header */
.site-header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--white);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.header-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  padding-top: 12px;
  padding-bottom: 12px;
}

.logo {
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--green-dark);
  text-decoration: none;
}

nav a {
  margin-left: 18px;
  color: var(--text);
  text-decoration: none;
  font-weight: 500;
}

nav a:hover { color: var(--green); }

/* Hero */
.hero {
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: var(--white);
  padding: 60px 20px;
  background: linear-gradient(135deg, #1f5d3a 0%, #2e8b57 50%, #8fcf9f 100%);
}

.hero-content { max-width: 700px; }

.hero h1 {
  font-size: 3rem;
  margin-bottom: 16px;
}

.hero p {
  font-size: 1.2rem;
  margin-bottom: 28px;
}

.btn {
  display: inline-block;
  background: var(--white);
  color: var(--green-dark);
  padding: 12px 28px;
  border-radius: 30px;
  text-decoration: none;
  font-weight: 600;
  transition: transform 0.2s;
}

.btn:hover { transform: translateY(-2px); }

/* Sections */
.section { padding: 64px 0; }
.section.alt { background: var(--green-light); }

.section h2 {
  font-size: 2rem;
  color: var(--green-dark);
  margin-bottom: 24px;
  text-align: center;
}

