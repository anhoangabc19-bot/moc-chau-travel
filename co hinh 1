:root {
  --green-dark: #1f5d3a;
  --green: #2e8b57;
  --green-light: #e8f4ec;
  --text: #2b2b2b;
  --muted: #666;
  --white: #fff;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: "Segoe UI", Roboto, Arial, sans-serif;
  color: var(--text);
  line-height: 1.7;
  background: var(--white);
}

.container {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 20px;
}

/* Header */
.site-header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--white);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

.header-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  padding-top: 12px;
  padding-bottom: 12px;
}

.logo {
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--green-dark);
  text-decoration: none;
}

nav a {
  margin-left: 18px;
  color: var(--text);
  text-decoration: none;
  font-weight: 500;
}

nav a:hover { color: var(--green); }

/* Hero */
.hero {
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: var(--white);
  padding: 60px 20px;
  background:
    linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)),
    url("images/hero.jpg") center / cover,
    linear-gradient(135deg, #1f5d3a 0%, #2e8b57 50%, #8fcf9f 100%);
}

img.card-img {
  width: 100%;
  height: 200px;
  object-fit: cover;
  display: block;
}

.wide-img {
  display: block;
  width: 100%;
  max-width: 700px;
  height: 320px;
  object-fit: cover;
  margin: 0 auto 28px;
  border-radius: 12px;
}

.hero-content { max-width: 700px; }

.hero h1 {
  font-size: 3rem;
  margin-bottom: 16px;
}

.hero p {
  font-size: 1.2rem;
  margin-bottom: 28px;
}

.btn {
  display: inline-block;
  background: var(--white);
  color: var(--green-dark);
  padding: 12px 28px;
  border-radius: 30px;
  text-decoration: none;
  font-weight: 600;
  transition: transform 0.2s;
}

.btn:hover { transform: translateY(-2px); }

/* Sections */
.section { padding: 64px 0; }
.section.alt { background: var(--green-light); }

.section h2 {
  font-size: 2rem;
  color: var(--green-dark);
  margin-bottom: 24px;
  text-align: center;
}

.lead {
  max-width: 800px;
  margin: 0 auto;
  text-align: center;
  font-size: 1.1rem;
  color: var(--muted);
}

/* Cards */
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 24px;
}

.card {
  background: var(--white);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  transition: transform 0.2s;
}

.card:hover { transform: translateY(-4px); }

.card-img {
  height: 160px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 3.5rem;
}

.img-1 { background: linear-gradient(135deg, #a8e063, #56ab2f); }
.img-2 { background: linear-gradient(135deg, #89f7fe, #66a6ff); }
.img-3 { background: linear-gradient(135deg, #43cea2, #185a9d); }
.img-4 { background: linear-gradient(135deg, #bdc3c7, #2c3e50); }
.img-5 { background: linear-gradient(135deg, #f6d365, #fda085); }
.img-6 { background: linear-gradient(135deg, #d4a373, #8d5524); }

.card-body { padding: 18px; }
.card-body h3 { color: var(--green-dark); margin-bottom: 8px; }
.card-body p { color: var(--muted); font-size: 0.95rem; }

/* Table */
.table {
  width: 100%;
  max-width: 700px;
  margin: 0 auto;
  border-collapse: collapse;
}

.table th, .table td {
  padding: 12px 16px;
  border-bottom: 1px solid #ddd;
  text-align: left;
}

.table th {
  background: var(--green);
  color: var(--white);
}

.note {
  max-width: 700px;
  margin: 16px auto 0;
  font-size: 0.9rem;
  color: var(--muted);
  font-style: italic;
}

/* Food */
.food-list {
  max-width: 800px;
  margin: 0 auto;
  list-style: none;
}

.food-list li {
  background: var(--white);
  padding: 14px 18px;
  margin-bottom: 12px;
  border-left: 4px solid var(--green);
  border-radius: 6px;
}

/* Tips */
.tips {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 20px;
}

.tip {
  background: var(--green-light);
  padding: 20px;
  border-radius: 12px;
}

.tip h3 { color: var(--green-dark); margin-bottom: 8px; }

/* Footer */
.site-footer {
  background: var(--green-dark);
  color: var(--white);
  text-align: center;
  padding: 24px 0;
  font-size: 0.9rem;
}

/* Mobile */
@media (max-width: 600px) {
  .hero h1 { font-size: 2.2rem; }
  nav a { margin: 0 10px 0 0; font-size: 0.9rem; }
  .section { padding: 44px 0; }
}
